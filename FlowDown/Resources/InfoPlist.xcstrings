    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork verwendet die Kamera nur, wenn du ein neues Foto an eine Unterhaltung anhängst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork uses the camera only when you choose to attach a new photo to a conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork usa la cámara solo cuando decides adjuntar una foto nueva a una conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork utilise l’appareil photo uniquement lorsque vous choisissez de joindre une nouvelle photo à une conversation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonworkは、会話に新しい写真を添付することを選択した場合にのみカメラを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork는 대화에 새 사진을 첨부하도록 선택한 경우에만 카메라를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork 仅在您选择为对话拍摄并附加新照片时使用相机。"
          }
        }
      }
    },
    "NSHumanReadableCopyright": {
      "comment": "Copyright (human-readable)",
      "localizations": {
