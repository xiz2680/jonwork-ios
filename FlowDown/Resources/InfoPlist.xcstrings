    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork verwendet dein lokales Netzwerk nur, wenn eine Verbindung zu einem Workspace in deinem Netzwerk hergestellt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork uses your local network only when connecting to a workspace on your network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork usa tu red local solo cuando se conecta a un espacio de trabajo de tu red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork utilise votre réseau local uniquement pour se connecter à un espace de travail présent sur ce réseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonworkは、ローカルネットワーク上のワークスペースに接続する場合にのみローカルネットワークを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork는 로컬 네트워크의 워크스페이스에 연결할 때만 로컬 네트워크를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork 仅在连接您本地网络中的工作区时使用本地网络。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork verwendet das Mikrofon nur, wenn du eine Nachricht diktierst. Audio wird von Apples Spracherkennungsdienst verarbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork uses the microphone only when you choose to dictate a message. Audio is processed by Apple's speech recognition service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork usa el micrófono solo cuando decides dictar un mensaje. El audio se procesa mediante el servicio de reconocimiento de voz de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork utilise le microphone uniquement lorsque vous choisissez de dicter un message. L’audio est traité par le service de reconnaissance vocale d’Apple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonworkは、メッセージの音声入力を選択した場合にのみマイクを使用します。音声はAppleの音声認識サービスで処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork는 메시지 받아쓰기를 선택한 경우에만 마이크를 사용합니다. 오디오는 Apple의 음성 인식 서비스에서 처리됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork 仅在您选择听写消息时使用麦克风。音频由 Apple 的语音识别服务处理。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork greift nur dann auf deine Fotomediathek zu, wenn du ein Bild speicherst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork uses photo library access only when you choose to save an image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork accede a tu fototeca solo cuando decides guardar una imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork accède à votre photothèque uniquement lorsque vous choisissez d’enregistrer une image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonworkは、画像の保存を選択した場合にのみ写真ライブラリへのアクセスを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork는 이미지를 저장하도록 선택한 경우에만 사진 보관함에 접근합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork 仅在您选择保存图片时访问照片图库。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy - Speech Recognition Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork verwendet Apples Spracherkennungsdienst nur, wenn du eine Nachricht diktierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork uses Apple's speech recognition service only when you choose to dictate a message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork usa el servicio de reconocimiento de voz de Apple solo cuando decides dictar un mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork utilise le service de reconnaissance vocale d’Apple uniquement lorsque vous choisissez de dicter un message."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonworkは、メッセージの音声入力を選択した場合にのみAppleの音声認識サービスを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork는 메시지 받아쓰기를 선택한 경우에만 Apple의 음성 인식 서비스를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Jonwork 仅在您选择听写消息时使用 Apple 的语音识别服务。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
